FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml .
RUN pip install --upgrade pip -q && pip install -e . && pip install pytest ruff

COPY backend/ backend/

EXPOSE 8000

CMD sh -c "python -m backend.db.migrate && python -m backend.db.seed && uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000"
